{
  "manifest_version": 3,
  "name": "Live Try-On",
  "version": "0.1.0",
  "description": "Try clothes on live with your webcam while you shop.",
  "action": { "default_title": "Live Try-On: open / close" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    { "resources": ["widget.html"], "matches": ["http://*/*", "https://*/*"] }
  ],
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"]
}
